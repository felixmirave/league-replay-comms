{
  "name": "league-replay-comms",
  "version": "0.2.1",
  "private": true,
  "description": "A local comms companion for League replay review",
  "author": "League Replay Comms contributors",
  "main": "dist/main/index.cjs",
  "type": "module",
  "commsValidation": {
    "profileArgumentVersion": 1
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "setup:electron": "install-electron",
    "prepare:native": "node scripts/prepare-native.ts",
    "prepare:ocr": "node scripts/prepare-ocr.ts",
    "prepare:notices": "node scripts/prepare-notices.ts",
    "prepare:splash": "node scripts/prepare-splash.ts",
    "test:packaging": "node --test scripts/notices.test.ts scripts/windows-native.test.ts scripts/portable-payload.test.ts scripts/after-pack.test.ts",
    "test:validation": "node --test scripts/validation-steps.test.ts scripts/artifact-evidence.test.ts",
    "validate:windows": "node scripts/validate-windows.ts",
    "verify:resources": "node scripts/verify-resources.ts",
    "verify:artifact": "node scripts/verify-artifact.ts",
    "build": "node scripts/build.ts",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:ocr-corpus": "vitest run tests/integration/clock-corpus.test.ts",
    "test:watch": "vitest",
    "test:engine": "node scripts/test-engine.ts",
    "smoke:ui": "npm run build && node scripts/smoke-ui.ts",
    "smoke:driver": "npm run build && node scripts/smoke-driver.ts",
    "test:review-ui": "npm run build && node scripts/test-review-ui.ts",
    "test:timing-ui": "node --test scripts/test-timing-ui.ts",
    "test:filters-browser": "npm run build && node scripts/test-filters-browser.ts",
    "test:volume-ui": "node --test scripts/test-volume-ui.ts",
    "test:startup-ui": "npm run build && node --test scripts/test-startup-ui.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "package:win": "npm run check && npm run verify:resources && node scripts/package-win.ts",
    "prepare:linux": "sh scripts/linux.sh --prepare",
    "verify:linux": "node scripts/verify-linux.ts",
    "dev:verify": "node scripts/dev-verify.ts",
    "test:dev-verification": "node --test scripts/replay-simulator.test.ts scripts/audio-verification.test.ts scripts/linux-runtime.test.ts"
  },
  "dependencies": {
    "@lofcz/deepfilternet-web": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "7zip-bin": "5.2.0",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "build": {
    "compression": "normal",
    "afterPack": "./scripts/after-pack.ts",
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "appId": "local.leaguereplaycomms.desktop",
    "productName": "League Replay Comms",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*",
          "!bin/linux-x64/**"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "signExecutable": false
    },
    "portable": {
      "splashImage": "build/splash.bmp",
      "artifactName": "LeagueReplayComms-${version}-${arch}.exe"
    }
  }
}
